# ============================================================================
# UTBK Tutor RAG Frontend - Pre-built Local Mode
# ----------------------------------------------------------------------------
# Gunakan ini ketika koneksi `npm ci` dari dalam container lambat / hang.
# 
# Cara pakai:
#   1. Build dist/ di host dulu:
#        cd frontend && npm install && npm run build
#   2. Build docker image dengan flag ini:
#        docker compose --profile ui -f docker-compose.yml \
#                       -f docker-compose.local.yml build frontend
#
# Image yang dihasilkan identik dengan Dockerfile utama, hanya
# proses build-nya yang dipindah ke host.
# ============================================================================

FROM nginx:alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY dist /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]